<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.bizplay</groupId>
    <artifactId>builder</artifactId>
    <version>1.0.1</version>
    <name>we-adk-builder</name>
    <description>기획 산출물 14종의 생애를 관리하는 빌더 서버</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.thymeleaf.extras</groupId>
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <!--
            ⛔ JPA(spring-boot-starter-data-jpa)를 되살리지 마라 — 2026-08-15 에 뺐다.
              데이터 접근은 전부 MyBatis 다. @Entity 도 JpaRepository 도 하나도 없다.
              트랜잭션 관리자는 아래 jdbc 스타터의 DataSourceTransactionManager 가 맡는다.

            ⚠ JdbcTemplate 을 직접 쓰는 곳이 하나 있다 — IdSequence 의 채번(select nextval).
              시퀀스 이름은 SQL 에 자리표시자로 못 넣어 이어붙일 수밖에 없어 매퍼 XML 로 안 내렸다.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.jsoup</groupId>
            <artifactId>jsoup</artifactId>
            <version>1.23.2</version>
        </dependency>
        <dependency>
            <groupId>com.microsoft.playwright</groupId>
            <artifactId>playwright</artifactId>
            <version>1.62.0</version>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            데이터 접근은 MyBatis 다 (2026-08-15 에 조각 다섯을 다 옮겼다:
            claude → ai → intake → project → account).
            까닭은 기술 우열이 아니라 인수인계다 — 이 서버를 나중에 받을 사내 개발자가 쓰는 것이 이쪽이다.
            규칙 정본은 docs/coding-conventions.md 의 「데이터 접근」 절이다.
        -->
        <dependency>
            <groupId>org.mybatis.spring.boot</groupId>
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <version>3.0.5</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Docker 없이 진짜 PostgreSQL 을 테스트마다 띄운다. 이웃 저장소 we-adk-admin 과 같은 방식. -->
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-database-spring-test</artifactId>
            <version>2.8.0</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.zonky.test</groupId>
            <artifactId>embedded-postgres</artifactId>
            <version>2.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- JDK 17 은 Windows ko_KR 에서 file.encoding 이 MS949 로 뜬다 (UTF-8 기본은 JDK 18 부터).
                     UTF-8 로 쓴 산출물 파일을 테스트가 MS949 로 읽어 깨지므로 포크된 테스트 JVM 에 못 박는다. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Dfile.encoding=UTF-8</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
