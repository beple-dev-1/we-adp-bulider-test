node_modules/
__pycache__/
*.pyc

# Maven 산출물 = 재생성물
target/

# 개인 설치 설정 (열쇠·비밀번호가 든다). 예시는 application-local.yml.example 이 맡는다.
src/main/resources/application-local.yml

# 브라우저 도구 산출물 = 재생성물
.playwright-mcp/

# 하네스(.claude/)는 저장소에 올리지 않고 각자 로컬에서만 관리한다 (2026-09-03 병주 확정).
# ⚠ 이력이 두 번 뒤집힌 자리다 — v1 은 전체 무시 → 이 저장소는 「서버에 배포되는 공용물」이라
#   추적으로 뒤집었다 → 다시 로컬 전용으로 되돌렸다. 되돌리기 전에 왜 바뀌었나를 먼저 물어라.
# ⛔ 이 줄만으로는 안 빠진다. 이미 추적 중이던 87개는 `git rm -r --cached .claude/` 로 뺐다.
#   하네스는 zip 으로 배포되고 판이 사람마다 달라, 올리면 저장소가 판 충돌 지점이 된다.
# ⚠ stack.yaml 의 toolPaths·env 에는 PC 경로가 들어간다 — 파일째 공유되면 그 값이 나간다.
.claude/
.worktrees/

# 저장소 루트에 떨어지는 화면 캡처 = 그때 한 번 보는 것
# ⛔ `*.png` 로 통째로 막지 마라 — src/main/resources/static/images/ 의 새 자산이
#   조용히 빠진다(claudecode-color.png 가 화면에서 쓰이는 자리다). 루트만 막는다.
/*.png

# 클론해 온 기획 레포는 여기 커밋되지 않는다
/workspaces/

# 로컬 검증 과정에서 생성되는 브라우저 프로필과 테스트 결과
/tmp/
/test-results/

# Builder architecture presentation drafts
/docs/builder-architecture-drafts/

# ── 팀 저장소로 보내지 않는 것 (2026-08-27 병주 확정) ─────────────────
# 조직 계정 저장소로 공유하면서 개인 작업 문맥을 뺀다.
# ⛔ ignore 만으로는 안 빠진다 — 이미 추적 중인 파일은 `git rm --cached` 가 먼저다.
#    이 줄들은 「앞으로 다시 추적되지 않게」 하는 자물쇠이지 삭제 명령이 아니다.
# ⚠ 파일은 로컬 디스크에 그대로 남는다. brief · relay 스킬이 계속 읽고 쓴다.
# ⚠ 과거 커밋 이력에는 남아 있다 — 이력은 손대지 않기로 했다.

# 코덱스 지침 — 병주만 코덱스를 쓴다 (2026-08-27 확정).
# 개인 머신 경로(JAVA_HOME)와 개인 MCP 설치(codebase-memory-mcp)가 들어 있어
# 팀원 코덱스가 읽으면 없는 경로·없는 도구를 지시받는다.
/AGENTS.md

# 개인 작업 지침 — CLAUDE.md 가 `@CLAUDE.local.md` 로 불러온다.
# 팀 사본에는 없는 것이 정상이고, 각자 자기 것을 두면 된다.
/CLAUDE.local.md

# VS Code 런처와 자바 설정 — /AGENTS.md 와 같은 까닭이다.
# JAVA_HOME · JDK 경로 · 로컬 PostgreSQL 경로 · 포트가 전부 개인 머신 값이라
# 팀원이 받으면 없는 경로를 가리킨다. 각자 자기 것을 두면 된다.
/.vscode/

# VS Code 자바 확장(이클립스 JDT)이 스스로 만드는 것 = 재생성물.
# 안에 이 기계의 JDK 경로와 ~/.m2 절대경로가 박힌다. 지워도 확장이 다시 만든다.
/.classpath
/.project
/.settings/

# 세션 인수인계 = 나와 클로드 사이의 작업 메모
/HANDOFF.md
/HANDOFF_BACKLOG.md
/HANDOFF_HISTORY.md
/HANDOFF_HISTORY_ARCHIVE.md

# 세션 작업물 — 구현 계획 · 스파이크 노트 · 캡틴 원장
# ⛔ specs/ 와 spikes/ 는 여기 넣지 마라. specs 는 자바 32곳이 `정본:` 으로
#   가리키는 설계 정본이고, spikes 는 그 specs 가 가리키는 증거물이다.
docs/superpowers/plans/
docs/superpowers/notes/
docs/superpowers/captain/

# 죽은 흐름만 설명하는 설계 문서 (2026-08-27 실측)
# 받은문서 · 요구사항정의서 · BRD · 추적매트릭스 — 전부 제품에서 빠진 것들이다.
# 자바가 가리키는 곳 0곳이라 빼도 주석이 안 깨진다.
# ⚠ 반만 죽은 문서(handoff-to-dev · push · concurrent-edit · ia ·
#   planner-journey · screen-shell)는 여기 넣지 마라 — 알맹이가 살아 있다.
docs/superpowers/specs/2026-08-07-intake-design.md
docs/superpowers/specs/2026-08-07-planner-one-flow-design.md
docs/superpowers/specs/2026-08-09-artifact-chain-redesign-design.md
docs/superpowers/specs/2026-08-09-brd-design.md
docs/superpowers/specs/2026-08-09-traceability-matrix-design.md
docs/superpowers/specs/2026-08-11-received-document-workspace-redesign.md

# 하네스 산출물·인수인계 — 로컬 전용이다 (파일 경로가 그대로 들어간다)
# 마찰 로그(.claude/harness-friction.jsonl)는 위 `.claude/` 가 이미 덮는다.
# ⛔ 개별 파일명이 아니라 패턴으로 적는다 — 나열하면 나중에 만든 로컬 문서가 안 걸린다.
.work/
/HARNESS_*.md
