# 이 파일을 application-local.yml 로 복사해 값을 채운다. 복사본은 저장소에 안 들어간다.
# 열쇠 만들기: openssl rand -base64 32
builder:
  super-account-login-id: admin
  super-account-password: 바꿔라-최초-로그인에서-바뀐다
  secret-key-base64: 여기에-Base64-32바이트
  # 배포 대상(리눅스 서버)의 값이다. 윈도우 개발 기계에서는 이 경로가 안 선다 —
  # C:/WorkSpace/my-idea/.builder-data 처럼 실재하는 경로로 바꿔라.
  data-root: /var/lib/we-adk-builder
  ai-run-timeout: 10m
  # Flow 개인용 API의 「내 API 키」에서 발급받은 값. 저장소에는 올리지 않는다.
  flow:
    api-key: 여기에-Flow-API-키
  # AI 실행기의 크기와 대기줄 — application.yml 에 기본값(4 · 50)이 있다.
  # 이 기계에서 달리 하고 싶을 때만 아래 주석을 풀어 덮어써라.
  # ⛔ ai-concurrency 를 1 로 두지 마라: 다른 BRD·다른 사람이 앞사람 10분을 한 줄로 기다린다.
  #ai-concurrency: 4
  #ai-queue-capacity: 50
  # 요구사항 분석이 쓸 모델 — application.yml 의 기본값은 sonnet 이다.
  # ⭐ 별칭만 적는다(sonnet·opus). 날짜 붙은 정식 ID 를 박으면 모델이 새로 나오며 낡는다.
  # 뽑히는 요구사항이 얕으면 opus 로 올려 보고, 빈 값으로 두면 그 계정의 기본 모델에 맡긴다.
  #requirement-analysis:
  #  model: opus
spring:
  datasource:
    # 개발 기계의 전역 .localdb (휴대용 PostgreSQL 17). 정본 설명은 그 폴더의 README.md.
    # 띄우기: powershell -ExecutionPolicy Bypass -File C:\WorkSpace\my-idea\.localdb\start-db.ps1
    # DB we_adk 한 채를 이웃 저장소 we-adk-admin 과 나눠 쓴다 —
    #   public = admin 몫(우리는 읽지 않는다) · builder = 빌더 몫
    # ⚠ 스키마 설정은 application.yml 에 있다. 여기로 옮기지 마라 — 테스트가 못 물려받는다.
    # DB 가 없을 때만 (createdb 는 PATH 에 없다 — 전체 경로로 부른다. 먼저 위 start-db.ps1 로 띄워야 한다):
    #   C:\WorkSpace\my-idea\.localdb\pgsql\bin\createdb.exe -h 127.0.0.1 -U postgres we_adk
    url: jdbc:postgresql://127.0.0.1:5432/we_adk
    username: postgres
    password: postgres
