<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bizplay.builder.devrequest.DevelopmentRequestMapper">
    <resultMap id="developmentRequest" type="com.bizplay.builder.devrequest.DevelopmentRequest">
        <constructor>
            <idArg column="id" javaType="java.lang.String"/>
            <arg column="project_id" javaType="java.lang.String"/>
            <arg column="number" javaType="_int"/>
            <arg column="frd_id" javaType="java.lang.String"/>
            <arg column="frd_number" javaType="_int"/>
            <arg column="title" javaType="java.lang.String"/>
            <arg column="system_code" javaType="java.lang.String"/>
            <arg column="facets" javaType="java.lang.String"/>
            <arg column="content_json" javaType="java.lang.String"/>
            <arg column="delivery_state" javaType="com.bizplay.builder.devrequest.DevelopmentRequest$DeliveryState"/>
            <arg column="planner_comment" javaType="java.lang.String"/>
            <arg column="attachment_name" javaType="java.lang.String"/>
            <arg column="attachment_path" javaType="java.lang.String"/>
            <arg column="attachment_size" javaType="java.lang.Long"/>
            <arg column="development_completed_on" javaType="java.time.LocalDate"/>
            <arg column="deployment_on" javaType="java.time.LocalDate"/>
            <arg column="previous_request_id" javaType="java.lang.String"/>
            <arg column="precheck_json" javaType="java.lang.String"/>
            <arg column="workspace_base_sha" javaType="java.lang.String"/>
            <arg column="workspace_head_sha" javaType="java.lang.String"/>
            <arg column="development_state" javaType="com.bizplay.builder.devrequest.DevelopmentState"/>
            <arg column="development_checked_at" javaType="java.time.Instant"/>
            <arg column="development_sync_error" javaType="java.lang.String"/>
            <arg column="development_merged_sha" javaType="java.lang.String"/>
            <arg column="development_merged_at" javaType="java.time.Instant"/>
            <arg column="created_at" javaType="java.time.Instant"/>
            <arg column="updated_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, project_id, number, frd_id, frd_number, title, system_code, facets, content_json,
        delivery_state, planner_comment, attachment_name, attachment_path, attachment_size,
        development_completed_on, deployment_on, previous_request_id, precheck_json,
        workspace_base_sha, workspace_head_sha, development_state, development_checked_at,
        development_sync_error, development_merged_sha, development_merged_at, created_at, updated_at
    </sql>

    <select id="allocateNumber" parameterType="java.lang.String" resultType="_int" flushCache="true">
        update builder.adk_builder_project
           set dev_request_seq = dev_request_seq + 1
         where id = #{projectId}
        returning dev_request_seq
    </select>

    <insert id="insert" parameterType="com.bizplay.builder.devrequest.DevelopmentRequest">
        insert into builder.adk_builder_dev_request
               (id, project_id, number, frd_id, frd_number, title, system_code, facets, content_json,
                delivery_state, planner_comment, workspace_base_sha, workspace_head_sha)
        values (#{id}, #{projectId}, #{number}, #{frdId}, #{frdNumber}, #{title},
                #{systemCode,jdbcType=VARCHAR}, #{facets,jdbcType=VARCHAR}, #{contentJson},
                #{deliveryState}, #{plannerComment,jdbcType=VARCHAR},
                #{workspaceBaseSha,jdbcType=VARCHAR}, #{workspaceHeadSha,jdbcType=VARCHAR})
    </insert>

    <select id="selectByProjectId" parameterType="java.lang.String" resultMap="developmentRequest">
        select <include refid="columns"/>
          from builder.adk_builder_dev_request
         where project_id = #{projectId}
         order by number desc
    </select>

    <select id="selectById" parameterType="java.lang.String" resultMap="developmentRequest">
        select <include refid="columns"/> from builder.adk_builder_dev_request where id = #{id}
    </select>

    <select id="selectByFrdId" parameterType="java.lang.String" resultMap="developmentRequest">
        select <include refid="columns"/> from builder.adk_builder_dev_request where frd_id = #{frdId}
    </select>




    <update id="updateContent">
        update builder.adk_builder_dev_request
           set content_json = #{contentJson}, updated_at = now()
         where id = #{id}
    </update>

    <update id="updateWorkspaceHeadSha">
        update builder.adk_builder_dev_request
           set workspace_head_sha = #{workspaceHeadSha}, updated_at = now()
         where id = #{id}
    </update>



    <select id="countReferencing" parameterType="java.lang.String" resultType="_int">
        select count(*) from builder.adk_builder_dev_request where previous_request_id = #{id}
    </select>

    <!-- ⛔ 상태를 where 에 둔다 — 서비스가 읽은 뒤 전송이 시작됐으면 여기서 0 이 되어 막힌다. -->
    <!--
      ⚠ 003(2026-09-06)에서 전송을 없앴지만 이 표는 죽은 채 남겼고 FK 에 on delete cascade 가 없다.
         003 이전에 쓰인 줄이 남아 있으면 아래 deleteNotSent 가 FK 위반으로 죽는다.
    -->
    <delete id="deleteDeliveryAttempts" parameterType="java.lang.String">
        delete from builder.adk_builder_dev_request_delivery where dev_request_id = #{devRequestId}
    </delete>

    <delete id="deleteNotSent" parameterType="java.lang.String">
        delete from builder.adk_builder_dev_request where id = #{id} and delivery_state = 'NOT_SENT'
    </delete>
</mapper>
