<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bizplay.builder.frd.FrdScreenMemoCommentMapper">

    <resultMap id="memoComment" type="com.bizplay.builder.frd.FrdScreenMemoComment">
        <constructor>
            <idArg column="id" javaType="java.lang.String"/>
            <arg column="frd_screen_id" javaType="java.lang.String"/>
            <arg column="author_account_id" javaType="java.lang.String"/>
            <arg column="author_name" javaType="java.lang.String"/>
            <arg column="content" javaType="java.lang.String"/>
            <arg column="created_at" javaType="java.time.Instant"/>
        </constructor>
    </resultMap>

    <insert id="insert" parameterType="com.bizplay.builder.frd.FrdScreenMemoComment">
        insert into builder.adk_builder_frd_screen_memo_comment
               (id, frd_screen_id, author_account_id, author_name, content, created_at)
        values (#{id}, #{frdScreenId}, #{authorAccountId}, #{authorName}, #{content}, #{createdAt})
    </insert>

    <select id="selectByScreenId" parameterType="java.lang.String" resultMap="memoComment">
        select id, frd_screen_id, author_account_id, author_name, content, created_at
          from builder.adk_builder_frd_screen_memo_comment
         where frd_screen_id = #{frdScreenId}
         order by created_at, id
    </select>
</mapper>
