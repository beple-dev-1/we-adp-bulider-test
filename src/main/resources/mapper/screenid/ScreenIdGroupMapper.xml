<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bizplay.builder.screenid.ScreenIdGroupMapper">

    <!-- ⛔ 인자 순서를 바꾸지 마라 — ScreenIdGroup 의 생성자와 자리로 맞춘다. -->
    <resultMap id="screenIdGroup" type="com.bizplay.builder.screenid.ScreenIdGroup">
        <constructor>
            <idArg column="id"          javaType="java.lang.String"/>
            <arg   column="project_id"  javaType="java.lang.String"/>
            <arg   column="system_code" javaType="java.lang.String"/>
            <arg   column="area_key"    javaType="java.lang.String"/>
            <arg   column="area_code"   javaType="java.lang.String"/>
            <arg   column="area_label"  javaType="java.lang.String"/>
            <arg   column="group_key"   javaType="java.lang.String"/>
            <arg   column="group_no"    javaType="_int"/>
            <arg   column="group_label" javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <select id="selectByProject" parameterType="java.lang.String" resultMap="screenIdGroup">
        select id, project_id, system_code, area_key, area_code, area_label,
               group_key, group_no, group_label
          from builder.adk_builder_screen_id_group
         where project_id = #{projectId}
         order by area_key, group_no
    </select>

    <insert id="insert" parameterType="com.bizplay.builder.screenid.ScreenIdGroup">
        insert into builder.adk_builder_screen_id_group
               (id, project_id, system_code, area_key, area_code, area_label,
                group_key, group_no, group_label)
        values (#{id}, #{projectId}, #{systemCode}, #{areaKey}, #{areaCode}, #{areaLabel},
                #{groupKey}, #{groupNo}, #{groupLabel})
    </insert>

</mapper>
