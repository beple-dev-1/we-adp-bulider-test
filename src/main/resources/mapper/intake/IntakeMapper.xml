<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    접수 한 건 — 받은 문서 1건 = 접수 1건이다.
    표의 뜻은 V4__intake.sql 과 V7__received_document_flow.sql 의 COMMENT 가 정본이다.

    ⚠ 표 이름 앞의 `builder.` 를 지우지 마라. 이 저장소의 표는 public 이 아니라 builder 스키마에 산다.
      MyBatis 는 Hibernate 의 default_schema 를 안 물려받는다 — 지우면 「표가 없다」로 죽는다.

    ⛔ process_type(처리 대기·요구사항 대상·참고 문서)은 2026-08-15 에 열째 폐기됐다.
      되살리지 마라 — 「참고 목적이면 아무것도 안 하면 된다」가 그 자리를 대신한다.
-->
<mapper namespace="com.bizplay.builder.intake.IntakeMapper">

    <!--
        setter 가 없는 값 묶음이라 생성자로 담는다.
        ⛔ 인자 순서를 바꾸지 마라 — Intake 의 생성자와 자리로 맞춘다.
           id·project_id·uploaded_by 는 셋 다 일곱 자리 글자라, 뒤바뀌어도 컴파일도 되고 예외도 안 난다.
           엉뚱한 프로젝트를 가리키는 것으로만 드러난다.
        ⚠ RequirementState 는 Intake 안의 중첩 열거라 `$` 로 적는다. 점으로 적으면 부팅 때 죽는다.
        ⚠ step 은 smallint 라 자바에서 primitive short 다 — 별칭은 `_short` 다(`short` 는 래퍼다).
    -->
    <resultMap id="intake" type="com.bizplay.builder.intake.Intake">
        <constructor>
            <idArg column="id"                javaType="java.lang.String"/>
            <arg   column="project_id"        javaType="java.lang.String"/>
            <arg   column="title"             javaType="java.lang.String"/>
            <arg   column="uploaded_by"       javaType="java.lang.String"/>
            <arg   column="uploaded_at"       javaType="java.time.Instant"/>
            <arg   column="step"              javaType="_short"/>
            <arg   column="requirement_state"
                   javaType="com.bizplay.builder.intake.Intake$RequirementState"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        id, project_id, title, uploaded_by, uploaded_at, step, requirement_state
    </sql>

    <select id="selectById" parameterType="java.lang.String" resultMap="intake">
        select <include refid="columns"/>
          from builder.adk_builder_intake
         where id = #{id}
    </select>

    <select id="selectByIdForUpdate" parameterType="java.lang.String" resultMap="intake">
        select <include refid="columns"/>
          from builder.adk_builder_intake
         where id = #{id}
           for update
    </select>

    <!--
        ⚠ 순서를 지우지 마라 — 목록 화면의 약속이 「최근에 올린 것이 위」다.
        ⚠ id 를 둘째 기준으로 둔 것은 uploaded_at 의 default 가 now() 이고, PostgreSQL 의 now() 는
          트랜잭션 시작 시각이라 한 트랜잭션에서 넣은 줄들이 전부 같은 시각을 갖기 때문이다.
          그것만으로는 순서가 안 정해져 실행할 때마다 뒤바뀐다.
    -->
    <select id="selectByProjectId" parameterType="java.lang.String" resultMap="intake">
        select <include refid="columns"/>
          from builder.adk_builder_intake
         where project_id = #{projectId}
         order by uploaded_at desc, id desc
    </select>

    <!--
        ⚠ uploaded_at 을 넣지 않는다 — DB 의 default now() 가 채운다.
        ⚠ id 는 넣는다. DB 에도 default 가 있지만 채번은 IdSequence 가 한다.
        ⚠ step 과 requirement_state 는 DB 에도 default 가 있지만 넣는다 — 「처음 값이 무엇인가」는
          업무가 정하는 것이라 자바 쪽 Intake.create 가 정본이고, 여기서 DB 기본값에 기대면
          그 정본이 둘로 갈린다. (시각처럼 DB 만 알 수 있는 값과 다른 자리다.)
    -->
    <insert id="insert" parameterType="com.bizplay.builder.intake.Intake">
        insert into builder.adk_builder_intake
               (id, project_id, title, uploaded_by, step, requirement_state)
        values (#{id}, #{projectId}, #{title}, #{uploadedBy}, #{step}, #{requirementState})
    </insert>

    <!--
        ⭐ 요구사항 분석을 집는 자리다. 「이미 돌고 있으면 못 집는다」가 여기 where 에 있다.
        ⛔ 이 조건을 자바로 옮기지 마라 — 읽기와 쓰기 사이에 남이 들어오면 두 실행이 같이 뜬다.
           (「거절을 바뀐 줄 0 으로 보이게 하지 마라」는 다른 자리의 규칙과 부딪히는 것처럼 보이지만
            여기서는 0 이 곧 「이미 돌고 있다」라는 **하나의 뜻**이라 사람에게 할 말이 정해진다.)
    -->
    <update id="updateRequirementStateToRunning">
        update builder.adk_builder_intake
           set requirement_state = 'RUNNING'
         where id                = #{intakeId}
           and requirement_state &lt;&gt; 'RUNNING'
    </update>

    <update id="updateRequirementState">
        update builder.adk_builder_intake
           set requirement_state = #{state}
         where id                = #{intakeId}
    </update>

    <!--
        재기동 청소. ⛔ 지우지 마라 — 굳은 RUNNING 이 남으면 위의 「집기」가 계속 0 을 돌려주고
        그 문서는 영영 다시 분석되지 않는다.
    -->
    <update id="updateStuckRunningToFailed">
        update builder.adk_builder_intake
           set requirement_state = 'FAILED'
         where requirement_state = 'RUNNING'
    </update>

    <delete id="deleteNotStarted">
        delete from builder.adk_builder_intake
         where id                = #{intakeId}
           and project_id        = #{projectId}
           and requirement_state = 'NOT_STARTED'
    </delete>

</mapper>
