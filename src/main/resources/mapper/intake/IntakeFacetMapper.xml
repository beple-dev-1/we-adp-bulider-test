<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<!--
    이 접수가 어느 적용 구분에 걸리나. 표의 뜻은 V4__intake.sql 의 COMMENT 가 정본이다.

    ⚠ 표 이름 앞의 `builder.` 를 지우지 마라. 이 저장소의 표는 public 이 아니라 builder 스키마에 산다.
      MyBatis 는 Hibernate 의 default_schema 를 안 물려받는다 — 지우면 「표가 없다」로 죽는다.

    ⭐ project_id 는 중복이 아니다. (project_id, name) 을 통째로 adk_builder_project_facet 에
      FK 로 건 것이 이 모양의 값이다 — 목록에 없는 적용 구분이 못 들어오고, 남의 프로젝트 값을
      빌려 쓰는 것도 DB 가 막는다.

    ⚠ 고치는 문이 없다. 적용 구분은 붙이거나 안 붙이는 것이지 이름을 바꿔 다는 것이 아니다.
-->
<mapper namespace="com.bizplay.builder.intake.IntakeFacetMapper">

    <!--
        setter 가 없는 값 묶음이라 생성자로 담는다.
        ⛔ 인자 순서를 바꾸지 마라 — IntakeFacet 의 생성자와 자리로 맞춘다.
           intake_id 와 project_id 는 둘 다 일곱 자리 글자라, 뒤바뀌어도 컴파일도 되고 예외도 안 난다.
        ⚠ 기본키가 (intake_id, name) 둘인데도 <idArg> 를 안 쓴다 — DTD 가 constructor 를
          (idArg*, arg*) 로 정해 idArg 를 앞에 몰아 두라고 요구하는데, 여기서는 그 둘 사이에
          project_id 가 끼어 있어 생성자 자리와 어긋난다. 평평한 목록이라 idArg 로 얻을 것도 없다.
    -->
    <resultMap id="intakeFacet" type="com.bizplay.builder.intake.IntakeFacet">
        <constructor>
            <arg column="intake_id"  javaType="java.lang.String"/>
            <arg column="project_id" javaType="java.lang.String"/>
            <arg column="name"       javaType="java.lang.String"/>
        </constructor>
    </resultMap>

    <sql id="columns">
        intake_id, project_id, name
    </sql>

    <select id="selectByIntakeId" parameterType="java.lang.String" resultMap="intakeFacet">
        select <include refid="columns"/>
          from builder.adk_builder_intake_facet
         where intake_id = #{intakeId}
         order by name
    </select>

    <!-- ⛔ 빈 목록으로 부르면 `in ()` 이 되어 SQL 이 깨진다. 부르는 쪽이 먼저 비었나를 본다. -->
    <select id="selectByIntakeIdIn" resultMap="intakeFacet">
        select <include refid="columns"/>
          from builder.adk_builder_intake_facet
         where intake_id in
        <foreach item="intakeId" collection="intakeIds" open="(" separator="," close=")">
            #{intakeId}
        </foreach>
         order by intake_id, name
    </select>

    <!--
        「지울 수 있나」를 묻는 자리다 — 이 프로젝트에서 지우려는 이름을 접수가 쓰고 있나.
        ⛔ 빈 목록으로 부르면 `in ()` 이 되어 SQL 이 깨진다. 부르는 쪽이 「지울 것이 있을 때만」 부른다.
    -->
    <select id="selectByProjectIdAndNameIn" resultMap="intakeFacet">
        select <include refid="columns"/>
          from builder.adk_builder_intake_facet
         where project_id = #{projectId}
           and name in
        <foreach item="name" collection="names" open="(" separator="," close=")">
            #{name}
        </foreach>
    </select>

    <insert id="insert" parameterType="com.bizplay.builder.intake.IntakeFacet">
        insert into builder.adk_builder_intake_facet (intake_id, project_id, name)
        values (#{intakeId}, #{projectId}, #{name})
    </insert>

</mapper>
