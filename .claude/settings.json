{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout -- *)",
      "Bash(chmod -R 777 *)",
      "Bash(> /etc/*)",
      "Bash(curl * | bash)",
      "Bash(wget * -O- | sh)",
      "Bash(sudo rm*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_dsa)",
      "Read(**/id_ecdsa)",
      "Read(**/id_ed25519)",
      "Read(**/*.ppk)",
      "Read(**/.ssh/**)",
      "Read(**/.npmrc)",
      "Read(**/.pypirc)",
      "Read(**/.netrc)",
      "Read(**/.git-credentials)",
      "Read(**/*service-account*.json)",
      "Read(**/credentials)",
      "Read(**/credentials.json)",
      "Read(**/secrets/**)",
      "Read(**/config/system.yaml)",
      "Read(**/*.local.yaml)",
      "Read(**/settings.local.json)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.npmrc)",
      "Read(~/.netrc)"
    ]
  }
}
